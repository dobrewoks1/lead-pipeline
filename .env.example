# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Провайдер: auto (Claude при наличии ключа, иначе эвристическая заглушка), anthropic, fake.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Параллельных запросов к модели.
WORKERS=4
# Версия промпта (v1, v2...). Пусто — последняя.
PROMPT_VERSION=

# Сводка в Telegram после прогона (по умолчанию выключено).
NOTIFY_TELEGRAM=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Выгрузка таблицы в Google Sheets (по умолчанию выключено; нужен pip install gspread).
GSHEETS_ENABLED=0
GOOGLE_SERVICE_ACCOUNT_JSON=
GSHEET_ID=
GSHEET_WORKSHEET=Заявки
